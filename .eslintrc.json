{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["tsconfig.json"],
        "createDefaultProgram": true
      },
      "extends": [
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/component-class-suffix": [
          "error",
          {
            "suffixes": ["Page", "Component"]
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@angular/common",
                "importNames": ["DecimalPipe"],
                "message": "Import NumberPipe from src/app/shared/pipes/number.pipe instead: DecimalPipe resolves its locale from LOCALE_ID, which this app never provides, so it prints en-US numbers to French users. Both are named `number` in templates, so the mistake compiles silently."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/shared/pipes/number.pipe.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {}
    }
  ]
}
